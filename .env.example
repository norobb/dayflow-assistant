# ─────────────────────────────────────────────────────────────────────────────
# Dayflow — Environment Variables
# Copy this file to .env and fill in the values for local development.
# Never commit .env or any real secrets to the repository.
# ─────────────────────────────────────────────────────────────────────────────

# GEMINI_API_KEY
# Required for Gemini AI API calls (natural-language analysis in dayflowAnalyzer.ts).
# In Google AI Studio this is injected automatically at runtime from user secrets.
# For local development, obtain a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# APP_URL
# The base URL where this application is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# In Google AI Studio this is injected automatically with the Cloud Run service URL.
# For local development: http://localhost:3000
APP_URL="http://localhost:3000"

# VITE_BASE_URL
# Controls the Vite build base path (vite.config.ts).
# Defaults to '/' if not set (correct for local dev and custom domains).
# Set to '/dayflow-assistant/' when deploying to https://norobb.github.io/dayflow-assistant/
# This variable is set automatically by the GitHub Actions deploy workflow.
# Do NOT set this manually in .env for local development.
# VITE_BASE_URL="/dayflow-assistant/"

# DISABLE_HMR
# Set to 'true' to disable Vite HMR and file watching during automated agent edits.
# Prevents flickering in AI Studio. Do not set in normal local development.
# DISABLE_HMR="true"
